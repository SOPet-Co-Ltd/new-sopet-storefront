# Browser GraphQL endpoint (proxied via next.config rewrites)
NEXT_PUBLIC_GRAPHQL_URL=/graphql
# Server-side GraphQL endpoint (direct backend URL)
GRAPHQL_SSR_URL=http://localhost:3002/graphql
# Server-only: Cloudflare WAF bypass for SSR (x-sopet-ssr-bypass). Required on UAT/prod; omit locally.
# GRAPHQL_SSR_BYPASS_SECRET=

# Must match backend JWT signing secret (JWT_SECRET). Used by edge `proxy.ts` to verify
# access tokens on /user/* routes. Without it in production, verification fails closed
# (treats users as unauthenticated → redirect to /login).
# JWT_SECRET=
# Optional; must match backend JWT_ISSUER / JWT_AUDIENCE (defaults: sopet / sopet-api)
# JWT_ISSUER=sopet
# JWT_AUDIENCE=sopet-api

# Must match backend OMISE_PUBLIC_KEY (Omise.js tokenization in browser)
NEXT_PUBLIC_OMISE_PUBLIC_KEY=

# Meta App ID for the Messenger share dialog on product pages.
# Required for the Messenger share button to work (dialog fails with an empty app_id).
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Public site origin for canonical URLs, Open Graph, sitemap, robots, AND product share links.
# Product share buttons build links from this origin (not the current host), so set it to the
# real public site — e.g. https://www.sopet.org in production — so shared links open the live
# product page with working link previews. No trailing slash required.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Brand name used in title templates and Open Graph siteName
NEXT_PUBLIC_SITE_NAME=Sopet
# Google Search Console HTML tag verification token (optional; public NEXT_PUBLIC_* only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics — GTM-first + optional direct GA4 (see docs/analytics.md). Omit locally for no-op.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXX
# Kill-switch: set to false/0 to disable scripts and dataLayer pushes even when IDs are set
# NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Trust Center / responsible disclosure contact (shown on /security)
# NEXT_PUBLIC_SECURITY_CONTACT=security@example.com

# CDN / R2 public URL for next/image remotePatterns (optional; **.r2.dev + cdn.sopet.org always allowed)
# UAT:  NEXT_PUBLIC_CDN_URL=https://pub-2bf64eff3b144315b312782329635c26.r2.dev
# Prod: NEXT_PUBLIC_CDN_URL=https://cdn.sopet.org
# NEXT_PUBLIC_CDN_URL=

# Optional: override GraphQL schema path for codegen (default: ../sopet-backend/src/schema.gql)
# GRAPHQL_SCHEMA_PATH=../sopet-backend/src/schema.gql
# Vercel/CI: fetched from GitHub when local schema is missing (see scripts/ensure-graphql-schema.mjs)
# GRAPHQL_SCHEMA_GITHUB_OWNER=
# GRAPHQL_SCHEMA_GITHUB_REPO=new-sopet-backend
# GRAPHQL_SCHEMA_GITHUB_REF=main
